# verges.{$DOMAIN_NAME} — public HTTPS site.
# Exists primarily to obtain and renew the Let's Encrypt certificate that
# the Hysteria2 service (verges) reuses for its QUIC listener.
verges.{$DOMAIN_NAME} {
	header X-Robots-Tag "noindex, nofollow"
	respond "OK" 200

	# Pin the issuer so the certificate storage path is deterministic:
	# data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/...
	# (Hysteria's config references that exact path. Do not remove.)
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
}

# Internal masquerade backend for Hysteria2 (in-network over shared_network).
# Hysteria forwards unauthenticated/non-proxy traffic here:
#   masquerade.proxy.url = https://caddy  (rewriteHost: true, insecure: true)
caddy {
	tls internal
	respond "<html><body><h1>It works!</h1></body></html>" 200
}
