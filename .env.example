# Secrets for the verges stack. Copy to .env (gitignored) and fill in:
#   cp .env.example .env
# Or run scripts/bootstrap.sh on the VPS, which generates it interactively.

# Email for the Let's Encrypt ACME account (certificate expiry notices).
SSL_EMAIL=you@example.com

# Hysteria2 auth password. Generate a URL-safe one:  openssl rand -hex 24
# (avoid characters that need URL percent-encoding or shell quoting).
VERGES_PASSWORD=change-me
