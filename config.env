# verges stack — desired state (committed to git).
# Secrets live in .env (gitignored, see .env.example).

# Which services to run, comma-separated. "verges" enables the Hysteria2
# proxy (UDP 443). Set to empty (COMPOSE_PROFILES=) to run caddy only,
# then run scripts/deploy.sh to apply.
COMPOSE_PROFILES=verges

# Public domain. The stack serves verges.$DOMAIN_NAME (DNS A record must
# point to the VPS IP) and uses it as the Hysteria2 SNI.
DOMAIN_NAME=aichorage.de

# Public UDP port for Hysteria2 (the container always listens on 443/udp).
VERGES_PORT=443

# Server-side port hopping range. The Hysteria2 server installs iptables/nftables
# DNAT rules so the whole range is redirected to the main UDP port. Clients
# should configure the same range + hop-interval (e.g. 30s).
VERGES_HOP_RANGE=20000-30000

# Pinned image versions — reproducibility. To upgrade: bump the tag, then
# run scripts/deploy.sh (after pushing) or scripts/update.sh (re-pull only).
CADDY_IMAGE=caddy:2.10.2
VERGES_IMAGE=tobyxdd/hysteria:v2.13.0
