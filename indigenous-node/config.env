# Indigenous node desired state (committed to git).
# Node-specific values are here; secrets live in .env (gitignored).

# ---------------------------------------------------------------------------
# Node identity (no IPs here — use DNS names)
# ---------------------------------------------------------------------------
NODE_NAME=indigenous
NODE_HOST=edge-direct.aichorage.de
DOMAIN_NAME=aichorage.de

# Public client entry (used only for client.sh link generation).
CLIENT_ENTRY_HOST=edge.aichorage.de
CLIENT_ENTRY_PORT=8443

# ---------------------------------------------------------------------------
# 3x-ui / xray versions
# ---------------------------------------------------------------------------
XUI_VERSION=v3.9.0

# ---------------------------------------------------------------------------
# VLESS + REALITY inbound
# ---------------------------------------------------------------------------
VLESS_PORT=443
VLESS_TAG=in-443-vless-reality
VLESS_EMAIL=user@aichorage.de

# Reality target must be a foreign site with TLS 1.3 + H2 and NOT a redirect.
# bootstrap.sh verifies it with openssl before creating the inbound.
REALITY_DEST=www.microsoft.com:443
REALITY_SNI=www.microsoft.com
REALITY_FINGERPRINT=chrome

# Multiple shortIds can be comma-separated. The first is used in client.sh.
REALITY_SHORT_IDS=a3f1,be42

# ---------------------------------------------------------------------------
# Panel (bound to loopback; access via SSH tunnel)
# ---------------------------------------------------------------------------
XUI_PANEL_PORT=2053
XUI_WEB_BASE_PATH=/xui
XUI_LISTEN_IP=127.0.0.1

# ---------------------------------------------------------------------------
# System tuning
# ---------------------------------------------------------------------------
# Swap file size. Set to 0 to skip. On a 3GB-disk VPS 256M is usually enough.
SWAP_SIZE_MB=256

# Backups: how many daily tarballs to keep in /root/backups.
BACKUP_KEEP_DAYS=7
