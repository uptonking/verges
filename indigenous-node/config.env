# Indigenous node desired state (committed to git).
# Node-specific values are here; secrets live in .env (gitignored).

# ---------------------------------------------------------------------------
# Node identity (no IPs here — use DNS names)
# ---------------------------------------------------------------------------
NODE_NAME=indigenous
NODE_HOST=edge-direct.aichorage.de
DOMAIN_NAME=aichorage.de

# Public client entry (used only for client.sh link generation).
CLIENT_ENTRY_HOST=edge.aichorage.de
CLIENT_ENTRY_PORT=8443

# ---------------------------------------------------------------------------
# 3x-ui / xray versions
# ---------------------------------------------------------------------------
XUI_VERSION=v3.9.0
# Pinned xray-core version. >= 26.7.11 rejects mihomo/sing-box clients
# (minClientVer default 26.3.27; 26.9.x also mandates ML-KEM ClientHellos);
# deploy.sh re-installs this pin after panel updates reset the bundled core.
XRAY_VERSION=v26.6.27

# ---------------------------------------------------------------------------
# VLESS + REALITY inbounds — two modes sharing UUID/keys/shortIds.
#
# direct : standalone mode, clients connect straight to this VPS (NODE_HOST).
# relay  : used behind the primary node's gost forwarder (edge.<domain> entry).
# Either inbound can be toggled in the 3x-ui webapp, or via the *_INBOUND_ENABLE
# flags below (flags are the source of truth on the next ./deploy.sh run).
# ---------------------------------------------------------------------------
DIRECT_VLESS_PORT=443
DIRECT_VLESS_TAG=in-443-vless-reality
DIRECT_INBOUND_ENABLE=1

RELAY_VLESS_PORT=8443
RELAY_VLESS_TAG=in-8443-vless-reality
RELAY_INBOUND_ENABLE=1

VLESS_EMAIL=user@aichorage.de

# Reality target must be a foreign site with TLS 1.3 + H2 and NOT a redirect.
# bootstrap.sh verifies it with openssl before creating the inbound.
# NOTE: www.microsoft.com is a BAD dest — xray's REALITY borrows the target's
# TLS flight shape, and Microsoft's record segmentation breaks mihomo's utls
# client (handshake stalls after the server flight). www.apple.com works.
REALITY_DEST=www.apple.com:443
REALITY_SNI=www.apple.com
REALITY_FINGERPRINT=chrome
# xray >= 26.7.11 defaults minClientVer to 26.3.27, which rejects mihomo/sing-box
# clients (they declare REALITY client version 1.8.2). Pin the floor to 1.8.2.
REALITY_MIN_CLIENT_VER=1.8.2

# Multiple shortIds can be comma-separated. The first is used in client.sh.
REALITY_SHORT_IDS=a3f1,be42

# ---------------------------------------------------------------------------
# Panel (bound to loopback; access via SSH tunnel)
# ---------------------------------------------------------------------------
XUI_PANEL_PORT=2053
XUI_WEB_BASE_PATH=/xui
XUI_LISTEN_IP=127.0.0.1

# ---------------------------------------------------------------------------
# System tuning
# ---------------------------------------------------------------------------
# Swap file size. Set to 0 to skip. On a 3GB-disk VPS 256M is usually enough.
SWAP_SIZE_MB=256

# Backups: how many daily tarballs to keep in /root/backups.
BACKUP_KEEP_DAYS=7
