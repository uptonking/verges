# Hysteria2 server config — GENERATED from config.yaml.template by the
# scripts (envsubst). Do not edit the generated file; edit the template.
# Hysteria has no env-var support, hence the template.

# QUIC listener inside the container (published as ${VERGES_PORT}/udp).
# Port hopping range is appended after a comma; the server uses iptables/nftables
# DNAT to redirect the range back to the main port (requires NET_ADMIN).
listen: :443,${VERGES_HOP_RANGE}

auth:
  type: password
  password: ${VERGES_PASSWORD}

# Reuse the Let's Encrypt certificate maintained by caddy (read-only mount
# of caddy's /data). Hysteria hot-reloads the pair when caddy renews
# (mtime is checked on every handshake). The path is deterministic because
# the Caddyfile pins the Let's Encrypt ACME issuer.
tls:
  cert: /caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/verges.${DOMAIN_NAME}/verges.${DOMAIN_NAME}.crt
  key: /caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/verges.${DOMAIN_NAME}/verges.${DOMAIN_NAME}.key

# Camouflage: forward non-proxy traffic to caddy (on the same host, since
# this container uses host networking), masquerading as an HTTPS site.
# insecure: true because the 127.0.0.1 site uses tls internal (self-signed).
# rewriteHost makes caddy's host matcher match.
masquerade:
  type: proxy
  proxy:
    url: https://127.0.0.1
    rewriteHost: true
    insecure: true
